    given-names: "Yucheng"
    email: "nqxq0899@leeds.ac.uk"
    affiliation: "SWJTU-Leeds Joint School, Southwest Jiaotong University / University of Leeds"
version: "v1.0"
date-released: "2026-10-18"
license: MIT
keywords:
  - "LLM evaluation"
  - "sycophancy"
  - "AI psychosis"
  - "cross-lingual safety"
  - "LLM-as-judge"
  - "replication"
